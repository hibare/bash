# Python
export PYTHONSTARTUP="$HOME/.python_startup.py"

# Go module config (versions managed by goenv)
export GOPRIVATE="*.hibare.in"
export GOPATH="$HOME/go"
export GONOPROXY="github.com/hibare"

# goenv
if [ -d "$HOME/.goenv/bin" ]; then
  export GOENV_ROOT="$HOME/.goenv"
  export PATH="$GOENV_ROOT/bin:$PATH"
fi

# OS detection (cached to avoid spawning uname on every shell startup)
export UNAME_S
UNAME_S="$(uname -s)"

# SSL
if [ "${UNAME_S}" = 'Darwin' ]; then
  export SSL_CERT_DIR="/usr/local/etc/openssl/certs"
else
  export SSL_CERT_DIR="/etc/ssl/certs"
fi

# Export GPG key
if [ -t 0 ]; then
  GPG_TTY=$(tty)
  export GPG_TTY
fi

# Dev flags (override by setting IS_LOCAL=false in ~/.bash_env or ~/.zshenv)
export IS_LOCAL="${IS_LOCAL:-true}"

# PATH modifications
export PATH="$GOPATH/bin:$HOME/.local/bin:$PATH"

# Terminal settings
export TERM="xterm-256color"
export LC_ALL="en_US.UTF-8"
